# Copy to .env and fill in. Only two lines are actually required:
# AI_API_KEY and LINK_PHONE.

# ── the link ───────────────────────────────────────────────
# Your WhatsApp Business number, full international form, NO PLUS SIGN.
# Example: a UK number +44 7700 900123 becomes 447700900123
# With this set, linking uses an 8 character code you type on the phone.
# Leave it blank and a QR code is printed to the log instead.
LINK_PHONE=

# How the bot appears under Settings > Linked devices on your phone.
DEVICE_NAME=Support Bot

# Nothing is answered for this long after connecting. WhatsApp replays
# history to a device that has just linked, and answering months of old
# messages cannot be undone. Do not lower this.
WARMUP_SECONDS=25
# Second guard on the same thing: anything older than this is history.
MAX_MESSAGE_AGE_MINUTES=10

# ── the model ──────────────────────────────────────────────
# Groq: free, no card. https://console.groq.com/keys
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.75

# Second slot, tried only when the first fails. Leave blank if you have
# nothing to put in it - the bot still works, it just has no safety net.
AI2_PROVIDER=
AI2_API_KEY=
AI2_MODEL=
AI2_BASE_URL=

# Voice notes. Uses the same Groq key unless you set a different one.
AUDIO_TRANSCRIBE=true
AUDIO_MODEL=whisper-large-v3-turbo
AUDIO_API_KEY=

# ── the human feel ─────────────────────────────────────────
# How long to wait for more messages before answering. Three quick lines are
# one thought, and this is what turns them into one reply.
BUNDLE_SECONDS=4
# The target gap between their message and ours, measured from THEIR message.
# Total = REPLY_DELAY_SECONDS + (words x MS_PER_WORD), capped, and the
# bundling wait and the model's own time are spent out of it, not added to it.
# The defaults land a normal reply at about 6 to 7 seconds.
REPLY_DELAY_SECONDS=5
MS_PER_WORD=90
MAX_DELAY_SECONDS=12
MIN_DELAY_MS=1200
READ_RECEIPT_MS=1600
BUBBLE_GAP_MS=2600
MAX_WORDS=55

# Hold overnight messages until morning. Set to false to answer around the clock.
QUIET_HOURS=true
DAY_START_HOUR=9
DAY_END_HOUR=23
TIMEZONE=Asia/Karachi

# Say the "support has moved to the group" line at most once per person per N days.
REMINDER_COOLDOWN_DAYS=7

# Hours after which a silent new-enquiry gets chased. Comma separated.
FOLLOWUP_HOURS=20,72

# ── running it ─────────────────────────────────────────────
# Commands work in your own "Message yourself" chat with no setup at all.
# Add numbers here only if somebody else should be able to run it too.
# Full international form, no plus. Comma separated.
CONTROL_NUMBERS=

# Where the activity feed goes. Blank means your own chat.
LOG_TO=
# all = every exchange - events = new contacts, handovers and failures only
LOG_LEVEL=events

# ── odds and ends ──────────────────────────────────────────
BRAND_NAME=Your Business
OWNER_NAME=
BOT_ENABLED=true
DB_PATH=/data/bot.db
AUTH_DIR=/data/auth
STUDENTS_CSV=/data/students.csv

# Optional: a video platform API secret, for pulling lecture transcripts
VDOCIPHER_KEY=

# ── linking over a browser (server installs) ───────────────
# On a server with no screen you cannot see the QR in the terminal.
# Set a random LINK_TOKEN and the container serves the QR at
#   http://127.0.0.1:3111/qr?t=<your token>
# CLEAR IT AGAIN once the phone has linked. While it is set, anyone who
# learns the token can link themselves to your WhatsApp account.
LINK_TOKEN=
QR_PORT=127.0.0.1:3111
HEALTH_PORT=3000

# ── knowledge base (optional) ──────────────────────────────
# Point it at a folder of .md/.docx/.pdf notes and the bot answers from them.
KB_ENABLED=false
KB_PATH=./notes

# ── the "support has moved" reminder ───────────────────────
# Off by default. Turn on only if you actually have a group to send people to,
# and set support.groupLink in src/knowledge.js.
GROUP_REMINDER=false

# ── LMS integration (optional) ─────────────────────────────
# Only needed for the scripts/lms-*.mjs helpers that pull lecture notes.
LMS_URL=
LMS_USER=
LMS_APP_PASSWORD=

# Everything else has a sensible default. See src/config.js for the full list
# of tunables (rate limits, timeouts, archive settings) if you need them.
